  "description": " A data validator fully written in Typescript.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "pkg-eslint-config": "github:OpenSourcePKG/pkg-eslint-config",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "directories": {
    "test": "tests"
  },
  "exports": {
